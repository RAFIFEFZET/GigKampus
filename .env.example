APP_NAME=GigKampus
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=id

LOG_CHANNEL=stderr
HASH_DRIVER=argon2id

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gigkampus
DB_USERNAME=gigkampus
DB_PASSWORD=gigkampus-local

SESSION_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=gigkampus-local
REVERB_APP_KEY=gigkampus-local-key
REVERB_APP_SECRET=gigkampus-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
